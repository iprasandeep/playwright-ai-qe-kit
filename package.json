{
  "name": "playwright-ai-qe-kit",
  "version": "1.0.0",
  "description": "Playwright TypeScript E2E kit with POM, CI, and AI-assisted failure notes",
  "author": "prasandeep",
  "license": "MIT",
  "scripts": {
    "test": "playwright test",
    "test:smoke": "playwright test --grep @smoke",
    "test:sanity": "playwright test tests/sanity.suite.spec.ts",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "report": "playwright show-report",
    "codegen": "playwright codegen https://demo.playwright.dev/todomvc",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "playwright",
    "e2e",
    "typescript",
    "sdet",
    "ai-qe"
  ],
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.15.0",
    "eslint-plugin-playwright": "^2.12.2",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.73.0"
  }
}
